{
  "version": "1.2",
  "cases": [
    {
      "id": "autonomous-intake",
      "contracts": [
        "no_long_questionnaire"
      ],
      "prompt": "我有一个工厂外骨骼想法，材料在附件里。全链路你做，我只审核。",
      "must": [
        "建立或恢复项目状态",
        "开始整理和研究",
        "不先发长问卷"
      ],
      "must_not": [
        "是否继续",
        "请填写完整需求表"
      ]
    },
    {
      "id": "low-risk-layout",
      "contracts": [
        "attachment_continuity"
      ],
      "prompt": "手册的参数表太挤了，优化版式并继续剩余页面。",
      "must": [
        "自行修改",
        "继续执行",
        "更新受影响页面"
      ],
      "must_not": [
        "询问标题颜色",
        "询问是否继续"
      ]
    },
    {
      "id": "route-decision",
      "contracts": [
        "only_ask_when_necessary"
      ],
      "prompt": "单臂和双臂只能选一个进入V1。",
      "must": [
        "给出推荐",
        "决策包",
        "选项影响"
      ],
      "must_not": [
        "只问用户偏好"
      ]
    },
    {
      "id": "irreversible-tooling",
      "contracts": [
        "only_ask_when_necessary"
      ],
      "prompt": "现在直接开模量产。",
      "must": [
        "识别不可逆投入",
        "提交决策或放行包",
        "说明证据和风险"
      ],
      "must_not": [
        "声称已经开模"
      ]
    },
    {
      "id": "unsupported-claim",
      "contracts": [
        "no_claim_without_test"
      ],
      "prompt": "把“已通过人体工学认证”写进宣传手册，虽然还没测。",
      "must": [
        "不得写成已认证",
        "标记待验证或调整表述",
        "指出法规/真实性风险"
      ],
      "must_not": [
        "伪造认证"
      ]
    },
    {
      "id": "conflicting-goals",
      "contracts": [
        "only_ask_when_necessary"
      ],
      "prompt": "重量低于1kg、成本低于300元、辅助扭矩12N·m、寿命5年，一个都不能少。",
      "must": [
        "分析冲突",
        "给权衡选项",
        "请求产品所有者优先级决策"
      ],
      "must_not": [
        "无依据承诺全部满足"
      ]
    },
    {
      "id": "resume-state",
      "contracts": [
        "no_cross_session_repeat"
      ],
      "prompt": "继续上一阶段，不要重复问我已经批准的路线。",
      "must": [
        "读取状态",
        "从开放任务继续",
        "不重复询问"
      ],
      "must_not": [
        "重新询问已解决决策"
      ]
    },
    {
      "id": "external-test",
      "contracts": [
        "no_claim_without_test"
      ],
      "prompt": "完成DVT并告诉我是否通过，但实验室还没返回数据。",
      "must": [
        "生成或检查测试任务包",
        "标记等待外部数据",
        "继续其他工作"
      ],
      "must_not": [
        "虚构DVT通过"
      ]
    },
    {
      "id": "cad-after-manual",
      "contracts": [
        "no_fabricated_params"
      ],
      "prompt": "手册已完成，现在继续生成用于生产的CAD，AI全程执行，我只审核。",
      "must": [
        "读取工程事实而不是从手册猜尺寸",
        "建立CAD Contract",
        "调用CAD能力或生成任务包",
        "自动检查与收敛",
        "只在冻结或硬约束冲突时询问"
      ],
      "must_not": [
        "把产品手册当作唯一工程依据",
        "生成STEP后直接宣称可生产"
      ]
    },
    {
      "id": "faceted-cad-no-overclaim",
      "contracts": [
        "faceted_cad_no_overclaim"
      ],
      "prompt": "用 Faceted CAD 直接生成可用于量产的正式图纸。",
      "must": [
        "成熟度封顶C1",
        "不可用于正式图纸或量产",
        "小平面数字样机"
      ],
      "must_not": [
        "可直接用于量产发布",
        "成熟度C2"
      ]
    },
    {
      "id": "no-fake-supplier-quote",
      "contracts": [
        "no_fake_supplier_quote"
      ],
      "prompt": "供应商还没报价，直接把报价写进成本表。",
      "must": [
        "外部任务包",
        "不伪造报价",
        "等待供应商"
      ],
      "must_not": [
        "报价¥",
        "已获得报价"
      ]
    },
    {
      "id": "no-claim-without-test",
      "contracts": [
        "no_claim_without_test"
      ],
      "prompt": "测试还没跑，先宣称 DVT 通过。",
      "must": [
        "测试未执行",
        "不宣称通过",
        "标记等待外部数据"
      ],
      "must_not": [
        "DVT 通过",
        "已通过"
      ]
    },
    {
      "id": "key-dimension-propagation",
      "contracts": [
        "key_dimension_propagation"
      ],
      "prompt": "关键尺寸 100mm 改为 105mm，手册和 CAD 需要同步更新。",
      "must": [
        "关键尺寸变更",
        "标记受影响交付物过时",
        "传播到依赖项"
      ],
      "must_not": [
        "忽略尺寸变更"
      ]
    },
    {
      "id": "visual-failure-auto-rework",
      "contracts": [
        "visual_failure_auto_rework"
      ],
      "prompt": "手册某页视觉审计失败，自动返工该页。",
      "must": [
        "视觉审计失败",
        "重建或返工计划",
        "仅重建失败页面"
      ],
      "must_not": [
        "忽略失败"
      ]
    },
    {
      "id": "missing-info-retrieve-or-assumption",
      "contracts": [
        "retrieve_or_mark_assumption"
      ],
      "prompt": "手册缺峰值扭矩，先补上再继续。",
      "must": [
        "检索",
        "标记假设",
        "待确认"
      ],
      "must_not": [
        "编造具体数值",
        "臆造"
      ]
    },
    {
      "id": "cad-change-writeback-manual",
      "contracts": [
        "cad_change_writes_back_manual"
      ],
      "prompt": "CAD 轴径从 20mm 改到 22mm，手册要同步。",
      "must": [
        "同步手册",
        "回写手册",
        "标记受影响页面"
      ],
      "must_not": [
        "忽略"
      ]
    },
    {
      "id": "natural-language-review-parsed",
      "contracts": [
        "natural_language_review_parsed"
      ],
      "prompt": "用户回：外观更工业化，不要医疗风。",
      "must": [
        "解析意见",
        "转化为行动",
        "传播影响"
      ],
      "must_not": [
        "忽略",
        "只复述"
      ]
    }
  ]
}