{
  "project_id": "WBX-1",
  "minimum_pages": 10,
  "prompts": [
    {
      "id": "P1",
      "purpose": "plan",
      "instruction_summary": "理论材料作为基础，先规划至少10张高清设计稿",
      "inputs": ["theory_materials/*"],
      "outputs": ["manual_plan.json"]
    },
    {
      "id": "P2",
      "purpose": "anchor_batch",
      "instruction_summary": "统一母版并锁定封面、原理和三页样板",
      "inputs": ["manual_plan.json", "theory_materials/*"],
      "outputs": ["anchors/*.png", "visual_bible.json"]
    },
    {
      "id": "P3",
      "purpose": "extension_batch",
      "instruction_summary": "以前批页面为附件，延续人物、结构、配色和版式生成剩余页",
      "inputs": ["anchors/*.png", "visual_bible.json", "theory_materials/*"],
      "outputs": ["pages/*.png"]
    }
  ]
}
