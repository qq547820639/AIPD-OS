{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPD Fact",
  "type": "object",
  "required": [
    "key",
    "value",
    "status"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "tolerance": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "V",
        "S",
        "C",
        "E",
        "A",
        "P",
        "T",
        "R",
        "U"
      ],
      "description": "事实的认知/分类状态（epistemic_status）。V=Verified（已验证为真，仅显式确认后使用）；S=Simulation（模拟/仿真值）；C=Calculation（可复核计算）；E=Reliable external evidence（可靠外部证据——外部来源（论文/报告/供应商）最多 E，绝不自动 V）；A=Assumption（假设）；P=Pending（待第三方确认）；T=Testable（待测试）；R=Retired（已退役：曾有效、已被取代或失效；不是 Rejected）；U=Unknown / 未验证（无证据或未确认的认知状态）。"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}