{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIPD Fact",
  "type": "object",
  "required": [
    "key",
    "value",
    "status"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "tolerance": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "V",
        "S",
        "C",
        "E",
        "A",
        "P",
        "T",
        "R"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}