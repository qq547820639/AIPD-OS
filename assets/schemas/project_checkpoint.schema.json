{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/aipd/project-checkpoint.schema.json",
  "title": "AIPD Project Checkpoint",
  "type": "object",
  "required": [
    "project",
    "facts",
    "evidence",
    "decisions",
    "deliverables",
    "risks",
    "dependencies",
    "changes"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "goal",
        "gate",
        "status",
        "version"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "gate": {
          "type": "string",
          "pattern": "^G[0-9]$"
        },
        "status": {
          "enum": [
            "active",
            "awaiting_owner_decision",
            "blocked_external",
            "internal_rework",
            "released",
            "archived"
          ]
        },
        "version": {
          "type": "string"
        },
        "owner_policy": {
          "type": "string"
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "key",
        "value",
        "status"
      ],
      "properties": {
        "fact_id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "V",
            "S",
            "C",
            "E",
            "A",
            "P",
            "T",
            "R"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conditions": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "kind",
        "title"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "decision_id",
        "topic",
        "status"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "resolved",
            "superseded"
          ]
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}